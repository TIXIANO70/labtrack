# Puerto y host de escucha del servidor HTTP
PORT=3000
HOST=127.0.0.1

# Ruta al archivo SQLite local
DB_PATH=./data/labtrack.db

# Origen permitido por CORS en desarrollo (separados por coma si hay varios)
CORS_ORIGIN=http://localhost:5173

# PIN opcional para proteger DELETE /api/incidencias/:id al exponer en LAN (vacio = desactivado)
ADMIN_PIN=

# Entorno de ejecucion (development | production | test)
NODE_ENV=development
